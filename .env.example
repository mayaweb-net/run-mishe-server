# Copy this file to `.env` and adjust values for your environment.

# App
NODE_ENV=development
PORT=4002
GLOBAL_PREFIX=api
CORS_ORIGIN=
CLIENT_ORIGIN=http://localhost:4001
CLIENT_REVALIDATE_URL=
REVALIDATE_SECRET=

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Database (PostgreSQL) — matches docker/pg.docker-compose.yml defaults
DATABASE_URL=postgresql://run-mishe:run-mishe@localhost:55432/run-mishe

# Auth
AUTH_OTP_TTL=600
AUTH_TEMP_FINISH_TTL=86400

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=16363
REDIS_PASSWORD=run-mishe
REDIS_CONNECT_TIMEOUT=10000

# S3 (RustFS) — matches docker/rustfs.docker-compose.yml defaults
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=run-mishe
S3_SECRET_KEY=run-mishe-s3-secret
S3_BUCKET=run-mishe
S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BASE_PATH=/api/files

# Kavenegar (SMS / OTP)
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=passlogin-dastres
